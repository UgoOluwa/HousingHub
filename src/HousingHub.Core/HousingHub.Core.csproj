<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed by Configuration/RequiredSecrets.cs, which both APIs call at startup. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <!-- Shared Sentry option-shaping lives in Observability/SentryOptionsConfigurator.cs,
         which both APIs call. Only the core SDK is needed here; the ASP.NET Core
         integration is referenced by the API projects themselves. -->
    <PackageReference Include="Sentry" Version="6.6.0" />
<PackageReference Include="SonarAnalyzer.CSharp" Version="10.23.0.137933">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
