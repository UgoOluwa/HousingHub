{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "//Cors": "Localhost origins belong in appsettings.Development.json only. This list is credentialed (AllowCredentials), so a localhost entry here makes anything on that port a trusted origin in production.",
    "Cors": {
        "AllowedOrigins": [
            "https://housinghub.ng",
            "https://www.housinghub.ng"
        ]
    },
    "//Secrets": "Secrets are intentionally empty. Supply them via environment variables or AWS Secrets Manager. Program.cs fails fast at startup if any are missing, rather than silently booting with a value committed to source control.",
    "Jwt": {
        "Secret": "",
        "Issuer": "HousingHub.API",
        "Audience": "HousingHub.Client",
        "ExpirationInMinutes": 30
    },
    "Google": {
        "ClientId": "296508772141-j05p5ec3f4rg1f958rb8um6aa405t2gb.apps.googleusercontent.com",
        "ClientSecret": ""
    },
    "Email": {
        "ResendApiKey": "",
        "SenderEmail": "noreply@housinghub.ng",
        "SenderName": "Housing Hub",
        "BaseUrl": "https://www.housinghub.ng",
        "AdminBaseUrl": "https://admin.housinghub.ng"
    },
    "AWS": {
        "DynamoDB": {
            "Region": "af-south-1"
        },
        "S3": {
            "BucketName": "housinghub-files-dev",
            "Region": "af-south-1"
        }
    }
}
