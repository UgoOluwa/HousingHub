{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:3000",
            "https://localhost:3000",
            "https://housinghub.ng",
            "https://www.housinghub.ng"
        ]
    },
    "Jwt": {
        "Secret": "your-jwt-secret-min-32-chars-replace-this",
        "Issuer": "HousingHub.API",
        "Audience": "HousingHub.Client",
        "ExpirationInMinutes": 30
    },
    "Google": {
        "ClientId": "296508772141-j05p5ec3f4rg1f958rb8um6aa405t2gb.apps.googleusercontent.com",
        "ClientSecret": "your-google-client-secret"
    },
    "Email": {
        "ResendApiKey": "your-resend-api-key",
        "SenderEmail": "noreply@housinghub.ng",
        "SenderName": "Housing Hub",
        "BaseUrl": "https://www.housinghub.ng"
    },
    "AWS": {
        "DynamoDB": {
            "Region": "af-south-1"
        },
        "S3": {
            "BucketName": "housinghub-files-dev",
            "Region": "af-south-1"
        }
    }
}
